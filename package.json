{
  "name": "reflow-by-swiftcart",
  "version": "2.0.0",
  "description": "Inventory recovery intelligence with accountable planning, scenario simulation, and grounded explanations",
  "main": "ops/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env ops/server.js",
    "server": "node --watch --env-file-if-exists=.env ops/server.js",
    "client": "npm run dev --prefix client",
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node client/node_modules/@playwright/test/cli.js test -c client/playwright.config.mjs",
    "evaluate": "node scripts/evaluate.js"
  },
